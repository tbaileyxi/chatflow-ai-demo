{
  "redirects": [
    {
      "source": "/t(/.*)?",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/room-photo/:path*",
      "destination": "https://dejuwyeypiggvlyfliap.supabase.co/storage/v1/object/public/room-photos/:path*"
    },
    {
      "source": "/((?!\\.well-known/|preview-test\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
